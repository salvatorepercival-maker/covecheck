+# The keyword the fix PR carries so that merging it closes the escalation report
+# it answers. GitHub treats Closes/Fixes/Resolves identically; one is named here
+# so every brief says the same thing and a reviewer has one string to look for.
+CLOSING_KEYWORD = "Closes"
