+def escalation_autoclose_instruction(key, established=False, why=""):
+    """What to tell the builder about linking the fix back to its report.
+
+    Returns the instruction, or None when the card has no escalation PR at all.
+
+    `key` is the decision card's own key, taken AFTER canonicalisation in
+    decide(). A request card (`req-...`) returns None: it was raised from a City
+    Hall request before any pull request existed, so there is nothing to link
+    and inventing a number would be far worse than saying nothing. That branch
+    keeps its existing behaviour untouched.
+
+    `established` IS THE WHOLE SAFETY PROPERTY, and it is passed in rather than
+    assumed. Closing syntax is emitted only when the caller has positively
+    established, against GitHub, that #key is an escalation report -- see
+    is_escalation_report(). Otherwise this returns the plain back-link that was
+    here before any of this existed, plus a plain statement of why the closing
+    line is absent, so the gap is visible to the builder and the reviewer rather
+    than silently filled in.
+
+    WHAT THIS REPLACED, AND WHY IT IS NOT MERELY A SOFTENED CLAIM. An earlier
+    version of this function emitted `Closes #key` unconditionally, on the
+    argument that a PR-keyed card is "by construction" keyed to its escalation
+    report. That argument was wrong: record-decision.sh accepts any PR number
+    and never checked what it named, so a card recorded against a pull request
+    somebody intended to merge would have produced a fix that silently closed
+    it. Nothing downstream could catch that -- closing syntax is invisible to
+    the merge gate. The construction guarantee is now actually made, in two
+    independent places: record-decision.sh refuses to write such a card at all,
+    and this refuses to emit the syntax even if one reaches it by another route.
+
+    WHY THIS WORKS, AND WHY NOT TO "CORRECT" IT BACK. GitHub's closing keywords
+    close a referenced PULL REQUEST, not only an issue. Verified by execution
+    against this repository on 2026-09-23, twice: a scratch PR whose body carried
+    `Closes #22` closed PR #22 on merge, and a replication carrying `Fixes #24`
+    closed PR #24 -- which had a real diff, so it was not closed for being empty.
+    Both ClosedEvents name the merging pull request as `closer`, stateReason
+    COMPLETED, where PRs closed by hand (#19, #12) carry `closer: null`.
+
+    Two GitHub APIs report this as not happening, and both are wrong about the
+    outcome: `closingIssuesReferences` is typed IssueConnection, so a PR cannot
+    appear in it whatever the link, and `CrossReferencedEvent.willCloseTarget`
+    read false on a reference that then closed its target. They are silent, not
+    negative. If this ever looks wrong, re-run the live test rather than
+    reasoning from those two fields.
+
+    Takes effect only on merge into the DEFAULT branch, which is the only way
+    anything lands here: `main` is protected and nothing reaches it except
+    through a pull request (AGENTS-CHARTER.md S2).
+    """
+    if is_request_key(key):
+        return None
+    if not established:
+        # DELIBERATELY NEVER SPELLS THE FORBIDDEN LINE OUT. An earlier draft of
+        # this said "do not write `Closes #N`" -- which put the exact dangerous
+        # string into the brief, where a builder could copy it out of a sentence
+        # telling it not to, and where a reviewer grepping the brief for closing
+        # syntax would find a hit. The prohibition is named by keyword only,
+        # never adjacent to the number.
+        return (
+            "Link the new PR back to #%d, as a plain reference. Do NOT put a "
+            "GitHub closing keyword (`%s`, `Fixes`, `Resolves`) in front of "
+            "that number anywhere in the pull request: #%d could not be "
+            "established as an escalation report -- %s -- and a closing keyword "
+            "aimed at a pull request somebody meant to merge would close it the "
+            "moment this fix lands, invisibly to the merge gate. If #%d really "
+            "is an escalation report, say so rather than adding the keyword by "
+            "hand: the check is then what needs fixing, not the pull request."
+            % (key, CLOSING_KEYWORD, key, why or "no reason was recorded", key)
+        )
+    return (
+        "Put `%s #%d` on its own line in the new pull request's DESCRIPTION -- "
+        "the body, not a commit message and not a comment. #%d is the escalation "
+        "report this fix answers (confirmed: %s), and that line is what closes "
+        "it automatically when the fix merges. Without it somebody has to close "
+        "#%d by hand, which is the exact thing this line exists to prevent, so "
+        "treat it as part of the change and not as a formality."
+        % (CLOSING_KEYWORD, key, key, why or "checked", key)
+    )
+
