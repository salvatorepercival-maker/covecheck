+def is_escalation_report(pr):
+    """Does this pull request's own content establish it as an escalation report?
+
+    Returns (True, why) or (False, why) -- the reason is returned either way
+    because both outcomes get quoted at somebody, and "no" is the one that needs
+    explaining.
+
+    `pr` is a dict as `gh pr view --json number,title,body,state,files` returns
+    it. Pure: it performs no I/O, so the rule can be tested without a network.
+    `_escalation_report_now()` below is the thing that fetches.
+
+    THE RULE -- two independent conditions, BOTH required:
+
+      1. It DECLARES itself an ESCALATE finding, in its title or in the first
+         non-blank line of its body. That is the charter's own convention.
+      2. It CHANGES nothing but AGENT-LOG.md, and changes at least one file.
+
+    Neither condition alone is enough, and that is not hypothetical -- checked
+    against all 25 pull requests in this repository on 2026-09-23:
+
+      * condition 1 alone also matches scratch PR #22
+      * condition 2 alone also matches #17, #15, #11, #9 and #3 -- ordinary
+        log-keeping pull requests that were MERGED, exactly the class this
+        must never emit closing syntax against
+      * BOTH conditions, plus "not merged", match #19 and #12 and nothing else
+        -- which is precisely the set of real escalation reports
+
+    DELIBERATELY CONSERVATIVE, AND THE ASYMMETRY IS THE POINT. A false negative
+    costs an automation: somebody closes a report by hand, which is exactly
+    where things stood before any of this existed. A false positive closes a
+    live pull request that was meant to merge, irreversibly as far as the gate
+    is concerned, and nobody sees it coming. So anything this cannot positively
+    establish is False, including anything it cannot read.
+    """
+    if not isinstance(pr, dict):
+        return False, "no pull request data to judge"
+
+    # A merged pull request is not a report -- it was a change, and it landed.
+    # Kept separate from the file check because it is a different argument, and
+    # because "it merged" is the single clearest disqualification there is.
+    state = (pr.get("state") or "").upper()
+    if state == "MERGED":
+        return False, "it is MERGED, so it was a change that landed, not a report"
+
+    title = pr.get("title") or ""
+    body = pr.get("body") or ""
+    first_line = next((ln for ln in body.splitlines() if ln.strip()), "")
+    declared = bool(_ESCALATION_MARKER.search(title)
+                    or _ESCALATION_MARKER.search(first_line))
+
+    files = pr.get("files")
+    if files is None:
+        # Not "it changed nothing" -- it is "nobody told us". Those are
+        # different, and collapsing them is how a check like this turns into a
+        # rubber stamp.
+        return False, "its changed-file list could not be read"
+    paths = set()
+    for f in files:
+        paths.add(f.get("path") if isinstance(f, dict) else f)
+    log_only = bool(paths) and paths <= ESCALATION_REPORT_FILES
+
+    if declared and log_only:
+        return True, ("it declares ESCALATE and changes nothing but %s"
+                      % ", ".join(sorted(ESCALATION_REPORT_FILES)))
+    if not declared and not log_only:
+        return False, ("it declares no ESCALATE finding and changes %d file(s) "
+                       "beyond the agent log" % len(paths - ESCALATION_REPORT_FILES))
+    if not declared:
+        return False, "it declares no ESCALATE finding in its title or opening line"
+    if not paths:
+        # An empty diff is not a report either. It is the shape the scratch
+        # probe PRs had (#22, #24), and it carries no finding to fix.
+        return False, "it changes no files at all, so it carries no report"
+    return False, ("it changes %s, which a report does not do"
+                   % ", ".join(sorted(paths - ESCALATION_REPORT_FILES)))
+
