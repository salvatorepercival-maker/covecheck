+def escalation_report_now(cfg, number):
+    """Read PR `number` live and judge it. Returns (True|False, why).
+
+    Separate from is_escalation_report() so the rule stays testable offline and
+    this stays the only place that touches the network.
+
+    Its own `gh` call rather than _pr_now()'s: this needs `body` and `files`,
+    and _pr_now() is on the merge path, where widening the query to drag a PR's
+    entire diff listing through every mergeability poll would be a cost paid by
+    code that has no use for it.
+
+    A read that fails returns False with the reason, never True. See the
+    asymmetry note in is_escalation_report().
+    """
+    rc, body, err = _run(
+        ["gh", "pr", "view", str(number), "--repo", cfg["gh"], "--json",
+         "number,title,body,state,files"], timeout=GH_TIMEOUT_SEC)
+    if rc != 0:
+        return False, ("it could not be read from GitHub (%s)"
+                       % (err.splitlines()[0] if err else "gh exited %s" % rc))
+    try:
+        data = json.loads(body)
+    except ValueError:
+        return False, "GitHub returned an unreadable response for it"
+    return is_escalation_report(data)
